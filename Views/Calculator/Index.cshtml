@{
    ViewData["Title"] = "Calculadora científica";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <main class="calculator">
        <header class="calculator-header">
            <span>Calculadora científica</span>
        </header>

        <section class="screen" aria-live="polite">
            <div id="expression" class="expression"></div>
            <div id="display" class="display">0</div>
            <div id="error" class="error"></div>
        </section>

        <section class="keypad" aria-label="Teclado de calculadora">
            <button type="button" class="function" data-action="clear">C</button>
            <button type="button" class="function" data-action="backspace">⌫</button>
            <button type="button" class="function" data-unary="percent">%</button>
            <button type="button" class="function" data-unary="reciprocal">1/x</button>
            <button type="button" class="operator" data-binary="divide">÷</button>

            <button type="button" class="function" data-unary="square">x²</button>
            <button type="button" class="function" data-unary="sqrt">²√x</button>
            <button type="button" class="function" data-binary="power">xʸ</button>
            <button type="button" class="function" data-unary="factorial">n!</button>
            <button type="button" class="operator" data-binary="multiply">×</button>

            <button type="button" class="function" data-unary="sin">sin</button>
            <button type="button" data-digit="7">7</button>
            <button type="button" data-digit="8">8</button>
            <button type="button" data-digit="9">9</button>
            <button type="button" class="operator" data-binary="subtract">−</button>

            <button type="button" class="function" data-unary="cos">cos</button>
            <button type="button" data-digit="4">4</button>
            <button type="button" data-digit="5">5</button>
            <button type="button" data-digit="6">6</button>
            <button type="button" class="operator" data-binary="add">+</button>

            <button type="button" class="function" data-unary="tan">tan</button>
            <button type="button" data-digit="1">1</button>
            <button type="button" data-digit="2">2</button>
            <button type="button" data-digit="3">3</button>
            <button type="button" class="equals" data-action="equals">=</button>

            <button type="button" class="function" data-unary="log">log</button>
            <button type="button" class="function" data-unary="ln">ln</button>
            <button type="button" data-action="sign">+/−</button>
            <button type="button" data-digit="0">0</button>
            <button type="button" data-action="decimal">,</button>
        </section>
    </main>

    <script src="~/js/calculator.js"></script>
</body>
</html>
